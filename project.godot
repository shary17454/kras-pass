; Kras Pass — party mini-game collection
; Godot 4 project configuration.
; See docs/architecture.md for the reasoning behind this layout.

config_version=5

[application]

config/name="Kras Pass"
config/description="كراس باس — لعبة حفلات ومنافسات مصغّرة / An original party mini-game collection."
config/version="1.0.0"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
boot_splash/show_image=false

[autoload]

Log="*res://src/core/logger.gd"
Balance="*res://src/core/balance.gd"
Loc="*res://src/localization/loc.gd"
SaveSystem="*res://src/save/save_system.gd"
UserSettings="*res://src/settings/settings_service.gd"
EventBus="*res://src/core/event_bus.gd"
InputRouter="*res://src/input/input_router.gd"
AudioManager="*res://src/audio/audio_manager.gd"
Registry="*res://src/core/registry.gd"
Progression="*res://src/progression/progression_service.gd"
Stats="*res://src/progression/stats_service.gd"
Achievements="*res://src/progression/achievements_service.gd"
Net="*res://src/net/net_service.gd"
Pool="*res://src/core/object_pool.gd"
Platform="*res://src/core/platform_service.gd"
SceneRouter="*res://src/core/scene_router.gd"
DevTools="*res://src/debug/dev_tools.gd"

[debug]

gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/integer_division=0
gdscript/warnings/native_method_override=0
; Godot escalates this one to an error by default. Data-driven code reads a lot
; of JSON, which is Variant by nature; we keep it as a warning and type the
; values explicitly at the point of use instead.
gdscript/warnings/inference_on_variant=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="sensor_landscape"
window/size/resizable=true

[input]

pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194305,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":6,"pressure":0.0,"pressed":false,"script":null)
]
}
debug_menu={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194336,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
ui_back={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194308,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":1,"pressure":0.0,"pressed":false,"script":null)
]
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_physics/layer_3="pickups"
3d_physics/layer_4="hazards"
3d_physics/layer_5="projectiles"

[physics]

3d/default_gravity=26.0
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.11, 1)
