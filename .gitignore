# Godot 4
.godot/
.import/
export.cfg
*.translation

# Build output
build/
exports/
*.dmg
*.app
*.exe
*.pck
*.zip
__pycache__/
*.pyc

# Xcode Cloud needs the generated iOS project, but not local archives/exports.
!build/
build/*
!build/ios/
!build/ios/**
build/ios/**/*.a
# Godot re-imports the app icons whenever the editor scans the project, which
# drops .import sidecars into the generated iOS folder. They are artefacts of a
# local scan, not part of the export, and export_ios.sh deletes the folder
# anyway.
build/ios/**/*.import
!build/ios/lfs_parts/**
build/ios/KrasPass.xcarchive/
build/ios/exported-appstore/
build/ios/KrasPass.xcodeproj/project.xcworkspace/xcuserdata/

# OS
.DS_Store
Thumbs.db
